# ============================================================
# RTC Delivery MSA Project - .gitignore
# ============================================================

# ========================
# Environment & Secrets
# ========================
.env
.env.*
.env.local
.env.*.local
!.env.example
**/application-dev.properties
**/application-prod.properties
**/application-local.properties
**/application-secret.properties
**/keys/jwt-private.pem
*.pem

# ========================
# Java / Spring Boot
# ========================
*.class
*.jar
*.war
*.ear
*.log
target/
build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
out/
bin/

# ========================
# Gradle
# ========================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ========================
# Node.js / Frontend
# ========================
node_modules/
.nuxt/
.output/
dist/
.nitro/
.cache/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# IDE
# ========================
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ========================
# OS
# ========================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ========================
# Docker
# ========================
docker-compose.override.yml
.docker/

# ========================
# Misc
# ========================
*.bak
*.tmp
*.temp
logs/
